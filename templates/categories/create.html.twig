{% extends 'base.html.twig' %}

{% block title %}Liste des Catégories{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Liste des Catégories</h1>

        {{ form_start(f) }}
        <div class="mb-3">
            {{ form_label(f.slug) }}
            {{ form_widget(f.slug, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(f.slug) }}
        </div>

        <div class="mb-3">
            {{ form_label(f.libelle) }}
            {{ form_widget(f.libelle, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(f.libelle) }}
        </div>

        <div class="mb-3">
            {{ form_label(f.description) }}
            {{ form_widget(f.description, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(f.description) }}
        </div>

        <div class="d-flex justify-content-end">
            {{ form_widget(f.save, {'attr': {'class': 'btn btn-primary'}}) }}
        </div>

        {{ form_end(f) }}
    </div>
{% endblock %}
