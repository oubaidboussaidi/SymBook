{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white text-center">
                <h1 class="mb-0">Modifier l'Utilisateur</h1>
            </div>

            <div class="card-body">
                {{ form_start(form) }}
                {{ form_widget(form) }}

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary rounded-pill shadow-sm">
                        ⬅️ Retour à la liste
                    </a>

                    <button class="btn btn-primary btn-lg rounded-pill shadow-sm">
                        💾 Sauvegarder
                    </button>
                </div>
                {{ form_end(form) }}
            </div>

        </div>
    </div>
{% endblock %}
