{% extends 'base.html.twig' %}

{% block title %}Détail de l'utilisateur{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Détail de l'utilisateur</h1>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Utilisateur #{{ user.id }}</h5>
                <p class="card-text"><strong>Nom :</strong> {{ user.nom }}</p>
                <p class="card-text"><strong>Prenom :</strong> {{ user.prenom }}</p>
                <p class="card-text"><strong>Email :</strong> {{ user.email }}</p>
                <p class="card-text"><strong>Rôles :</strong> {{ user.roles|join(', ') }}</p>
                <p class="card-text"><strong>Vérifié :</strong>
                    {% if user.isVerified %}
                        <span class="badge bg-success">Oui</span>
                    {% else %}
                        <span class="badge bg-danger">Non</span>
                    {% endif %}
                </p>
            </div>
        </div>

        <div class="mt-4">
            <a href="{{ path('app_user_index') }}" class="btn btn-secondary">⬅️ Retour à la liste</a>
            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-primary">✏️ Modifier</a>

            <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" style="display:inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                <button class="btn btn-danger">🗑️ Supprimer</button>
            </form>
        </div>
    </div>
{% endblock %}
