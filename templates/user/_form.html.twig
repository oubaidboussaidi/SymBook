{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_label(form.email) }}
        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.email) }}
    </div>

    <div class="col-md-6 mb-3">
        {{ form_label(form.roles) }}
        {{ form_widget(form.roles, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.roles) }}
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        {{ form_label(form.password) }}
        {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.password) }}
    </div>

    <div class="col-md-6 mb-3">
        {{ form_label(form.isVerified) }}
        <div class="form-check">
            {{ form_widget(form.isVerified, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_errors(form.isVerified) }}
        </div>
    </div>
</div>

<div class="text-center mt-4">
    <button class="btn btn-success rounded-pill" type="submit">
        ✅ Enregistrer
    </button>
</div>
{{ form_end(form) }}
