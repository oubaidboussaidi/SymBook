{% extends 'base.html.twig' %}

{% block title %}Créer un Nouvel Utilisateur{% endblock %}

{% block body %}
    <div class="container py-5">
        {{ form_start(form) }}

        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_row(form.nom, {
                    label_attr: {'class': 'form-label'},
                    attr: {'class': 'form-control'}
                }) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_row(form.prenom, {
                    label_attr: {'class': 'form-label'},
                    attr: {'class': 'form-control'}
                }) }}
            </div>
        </div>

        <div class="mb-3">
            {{ form_row(form.email, {
                label_attr: {'class': 'form-label'},
                attr: {'class': 'form-control'}
            }) }}
        </div>

        <div class="mb-3">
            <label class="form-label d-block">{{ form.roles.vars.label }}</label>
            {% for roleField in form.roles %}
                <div class="form-check form-check-inline">
                    {{ form_widget(roleField, {attr: {'class': 'form-check-input'}}) }}
                    <label class="form-check-label">{{ roleField.vars.label }}</label>
                </div>
            {% endfor %}
        </div>

        <div class="mb-3">
            {{ form_row(form.password, {
                label_attr: {'class': 'form-label'},
                attr: {'class': 'form-control'}
            }) }}
        </div>

        <div class="form-check mb-3">
            {{ form_widget(form.isVerified, {attr: {'class': 'form-check-input'}}) }}
            {{ form_label(form.isVerified, null, {'label_attr': {'class': 'form-check-label'}}) }}
        </div>

        <div class="text-center">
            <button class="btn btn-success rounded-pill">Enregistrer</button>
        </div>

        {{ form_end(form) }}

    </div>
{% endblock %}
