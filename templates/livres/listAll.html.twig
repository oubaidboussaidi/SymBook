{% extends 'base.html.twig' %}

{% block title %}Liste des Livres{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="mb-3">Liste des Livres</h1>
            <a href="{{ path('app_livres_create') }}" class="btn btn-success btn-lg">
                <i class="fas fa-plus"></i> Ajouter Livre
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered shadow-sm mt-3">
                <thead class="table-dark">
                <tr>
                    <th>Titre</th>
                    <th>Éditeur</th>
                    <th>Date d'Édition</th>
                    <th>Prix</th>
                    <th>Cathegorie</th>
                    <th class="text-center">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for livre in livres %}
                    <tr>
                        <td>{{ livre.titre }}</td>
                        <td>{{ livre.editeur }}</td>
                        <td>{{ livre.dateEdition|date('Y-m-d') }}</td>
                        <td>{{ livre.prix }}</td>
                        <td>{{ livre.cat.libelle ?? 'Aucune catégorie' }}</td>
                        <td class="text-center">
                            <a href="{{ path('app_livres_show', { 'id': livre.id }) }}" class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i> Détails
                            </a>

                            <a href="{{ path('app_livres_edit', { 'id': livre.id }) }}" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Modifier
                            </a>

                            <a href="{{ path('app_livres_delete', { 'id': livre.id }) }}" class="btn btn-danger btn-sm" onclick="return confirm('Voulez-vous vraiment supprimer ce livre ?');">
                                <i class="fas fa-trash-alt"></i> Supprimer
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted">Aucun livre trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

        </div>
        <div class="navigation">
            {{ knp_pagination_render(livres) }}
        </div>
    </div>
{% endblock %}
