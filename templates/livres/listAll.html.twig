{% extends 'base.html.twig' %}

{% block title %}Liste des Livres{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Books List :</h1>

        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Title</th>
                    <th scope="col">Editer</th>
                    <th scope="col">Price</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for livre in livres %}
                    <tr class="table-light"> {# All rows will have the "table-light" class #}
                        <td>{{ livre.id }}</td>
                        <td>{{ livre.titre }}</td>
                        <td>{{ livre.editeur }}</td>
                        <td>{{ livre.prix }} €</td>
                        <td>
                            <a href="{{ path('app_livres_show', {id: livre.id}) }}" class="btn btn-info btn-sm">See details</a>
                            <a href="{{ path('app_livres_delete', {id: livre.id}) }}" class="btn btn-danger btn-sm" onclick="return confirm('Voulez-vous vraiment supprimer ce livre ?');">Delete</a>
                        </td>
                    </tr>
                {% else %}
                    <tr class="table-danger">
                        <td colspan="5" class="text-center">Aucun livre trouvé</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
