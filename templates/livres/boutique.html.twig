{% extends 'base.html.twig' %}

{% block title %}Boutique{% endblock %}

{% block body %}
    <div class="container py-4">

        <h1 class="mb-4 text-center">Boutique de Livres</h1>

        <form method="get" action="{{ path('app_livres_boutique') }}" class="mb-5">
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="titre" class="form-label">Titre :</label>
                    <input type="text" id="titre" name="titre" class="form-control" value="{{ app.request.get('titre') }}">
                </div>
                <div class="col-md-4">
                    <label for="editeur" class="form-label">Éditeur :</label>
                    <input type="text" id="editeur" name="editeur" class="form-control" value="{{ app.request.get('editeur') }}">
                </div>
                <div class="col-md-4">
                    <label for="cat" class="form-label">Catégorie :</label>
                    <input type="text" id="cat" name="cat" class="form-control" value="{{ app.request.get('cat') }}">
                </div>
                <div class="col-12 mt-3 text-end">
                    <button type="submit" class="btn btn-primary">Rechercher</button>
                    <a href="{{ path('app_livres_boutique') }}" class="btn btn-secondary ms-2">Réinitialiser les filtres</a>
                </div>
            </div>
        </form>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
            {% for livre in livres %}
                <div class="col">
                    <div class="card h-100 shadow-sm rounded-4">
                        <div style="height: 200px; overflow: hidden;">
                            <img src="{{ livre.image }}"
                                 class="card-img-top h-100 w-100"
                                 alt="{{ livre.titre }}"
                                 style="object-fit: cover;">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-primary">{{ livre.titre }}</h5>
                            <p class="card-text flex-grow-1">
                                <strong>Éditeur :</strong> {{ livre.editeur }}<br>
                                <strong>Catégorie :</strong> {{ livre.cat.libelle }}<br>
                                <strong>Prix :</strong> {{ livre.prix }} €
                            </p>
                            <div class="mt-auto">
                                <div class="d-flex gap-2 justify-content-between">
                                    <a href="{{ path('app_livres_show_user', {'id': livre.id}) }}"
                                       class="btn btn-outline-primary btn-sm flex-fill text-nowrap"
                                       style="font-size: 0.8rem; padding: 0.4rem 0.6rem;">
                                        Voir détail
                                    </a>
                                    {% if is_granted('ROLE_USER') %}
    <form method="post" action="{{ path('cart_add', { id: livre.id }) }}">
        <button type="submit" class="btn btn-success btn-sm w-100">
            <i class="fas fa-cart-plus"></i> Ajouter au Panier
        </button>
    </form>
{% endif %}

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-warning text-center">
                        Aucun livre trouvé.
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="pagination mt-4 d-flex justify-content-center">
            {{ knp_pagination_render(livres) }}
        </div>

    </div>
{% endblock %}
