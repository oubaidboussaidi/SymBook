{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Mon Panier</h1>

    {# Flash messages #}
    {% for label, messages in app.flashes() %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% if items|length == 0 %}
        <p>Votre panier est vide.</p>
    {% else %}
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Livre</th>
                    <th>Quantité (Stock dispo)</th>
                    <th>Prix Unitaire</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>{{ item.livre.titre }}</td>

                        <!-- Quantity modification -->
                        <td>
                            <div class="d-flex align-items-center">
                                <form method="post" action="{{ path('cart_update_quantity', { id: item.livre.id }) }}" class="d-flex align-items-center">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            onclick="let input = this.parentNode.querySelector('input'); if (input.stepDown) input.stepDown();">
                                        -
                                    </button>
                                    <input type="number"
                                           name="quantity"
                                           value="{{ item.quantity }}"
                                           min="1"
                                           max="{{ item.livre.quantiteDisponible }}"
                                           class="form-control text-center"
                                           style="max-width: 70px;">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            onclick="let input = this.parentNode.querySelector('input'); if (input.stepUp) input.stepUp();">
                                        +
                                    </button>
                                    <button type="submit" class="btn btn-primary btn-sm ms-2">Mettre à jour</button>
                                </form>
                                <small class="text-muted ms-2">Stock: {{ item.livre.quantiteDisponible }}</small>
                            </div>
                        </td>

                        <td>{{ item.livre.prix|number_format(2, '.', ',') }} DT</td>

                        <td>{{ (item.livre.prix * item.quantity)|number_format(2, '.', ',') }} DT</td>

                        <td>
                            <a href="{{ path('cart_remove', { id: item.livre.id }) }}" class="btn btn-danger btn-sm">Supprimer</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <h3>Total : {{ total|number_format(2, '.', ',') }} DT</h3>
            <form action="{{ path('cart_clear_all') }}" method="post">
                <button type="submit" class="btn btn-warning btn-sm">Vider le Panier</button>
            </form>
        </div>
    {% endif %}
    
    {% if is_granted('ROLE_USER') and items is not empty %}
        <form method="get" action="{{ path('app_commande_valider') }}">
            <button type="submit" class="btn btn-success w-100 mt-4">
                <i class="fas fa-check-circle"></i> Passer la commande
            </button>
        </form>
    {% endif %}

</div>
{% endblock %}
