{% extends 'base.html.twig' %}

{% block title %}Forgot Password{% endblock %}

{% block body %}
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          {{ flash_error }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}

      <div class="card shadow-sm">
        <div class="card-body">
          <h2 class="card-title mb-4 text-center">Reset your password</h2>

          {{ form_start(requestForm) }}
            <div class="mb-3">
              {{ form_label(requestForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
              {{ form_widget(requestForm.email, {'attr': {'class': 'form-control'}}) }}
              {{ form_errors(requestForm.email) }}
            </div>

            <div class="mb-3 text-muted small text-center">
              Enter your email address and we’ll send you a password reset link.
            </div>

            <button class="btn btn-primary w-100">Send Reset Link</button>
          {{ form_end(requestForm) }}

          <div class="mt-3 text-center">
            <a href="{{ path('app_login') }}">Back to login</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
