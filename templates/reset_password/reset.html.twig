{% extends 'base.html.twig' %}

{% block title %}Choose a New Password{% endblock %}

{% block body %}
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-body p-4">
            <h2 class="card-title mb-4 text-center">Reset Your Password</h2>

            {{ form_start(resetForm) }}

            <div class="mb-3">
              {{ form_label(resetForm.plainPassword.first, 'New Password', {'label_attr': {'class': 'form-label'}}) }}
              {{ form_widget(resetForm.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Enter new password'}}) }}
              {{ form_errors(resetForm.plainPassword.first) }}
            </div>

            <div class="mb-3">
              {{ form_label(resetForm.plainPassword.second, 'Repeat Password', {'label_attr': {'class': 'form-label'}}) }}
              {{ form_widget(resetForm.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Repeat new password'}}) }}
              {{ form_errors(resetForm.plainPassword.second) }}
            </div>

            <button class="btn btn-primary w-100">Reset Password</button>

            {{ form_end(resetForm) }}

            <div class="mt-3 text-center">
              <a href="{{ path('app_login') }}" class="small">Back to login</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}