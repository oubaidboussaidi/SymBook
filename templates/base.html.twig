<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}My Site{% endblock %}</title>

    <link rel="icon" href="{{ asset('favicon.ico') }}" type="image/x-icon" />
    <link rel="stylesheet" href="{{ asset('css/bootstrap.css') }}" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">SymBook 📚</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarColor01">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link active" href="/">
            <i class="fas fa-home" style="color: white;"></i> Home
          </a>
        </li>

        {% if is_granted('ROLE_ADMIN') %}
          <li class="nav-item">
            <a class="nav-link" href="/livres/list">
              <i class="fas fa-book" style="color: white;"></i> Book List
            </a>
          </li>
        {% endif %}

        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_livres_boutique') }}">
            <i class="fas fa-store" style="color: white;"></i> Boutique
          </a>
        </li>

        {% if is_granted('ROLE_ADMIN') %}
          <li class="nav-item">
            <a class="nav-link" href="{{ path('admin_categories') }}">
              <i class="fas fa-tags" style="color: white;"></i> Categories
            </a>
          </li>
        {% endif %}

        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_chat') }}">
            <i class="fas fa-robot" style="color: white;"></i> Chatbot
          </a>
        </li>
      </ul>

      <ul class="navbar-nav ms-auto">
        {% if app.user %}
          <li class="nav-item">
            <a class="nav-link" href="{{ path('cart_index') }}">
              <i class="fas fa-shopping-cart" style="color: white;"></i> Cart
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{ path('app_commande_historique') }}">
              <i class="fas fa-receipt" style="color: white;"></i> My Orders
            </a>
          </li>

          {% if is_granted('ROLE_ADMIN') %}
            <li class="nav-item">
              <a class="nav-link" href="{{ path('admin_commande_index') }}">
                <i class="fas fa-clipboard-list" style="color: white;"></i> All Orders
              </a>
            </li>
          {% endif %}

          <li class="nav-item">
            <a class="nav-link disabled" href="#">
              <i class="fas fa-user" style="color: white;"></i> {{ app.user.userIdentifier }}
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{ path('app_logout') }}">
              <i class="fas fa-sign-out-alt" style="color: white;"></i> Logout
            </a>
          </li>
        {% else %}
          <li class="nav-item">
            <a class="nav-link" href="{{ path('app_login') }}">
              <i class="fas fa-sign-in-alt" style="color: white;"></i> Login
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{ path('app_register') }}">
              <i class="fas fa-user-plus" style="color: white;"></i> Register
            </a>
          </li>
        {% endif %}
      </ul>
    </div>
  </div>
</nav>

{% for type, messages in app.flashes %}
  {% for message in messages %}
    <div class="alert alert-{{ type }}">
      {{ message }}
    </div>
  {% endfor %}
{% endfor %}

{% block body %}{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
