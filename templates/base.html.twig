<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}My Site{% endblock %}</title>
    
    <link rel="stylesheet" href="{{ asset('css/bootstrap.css') }}">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

</head>
<body>
<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">SymBook 📚</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <div class="collapse navbar-collapse" id="navbarColor01">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link active" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/livres/list">Book List</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_livres_boutique') }}">
            <i class="fas fa-store" style="color: white;"></i> Boutique
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ path('admin_categories') }}">Categories</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#">About</a>
        </li>
      </ul>

    <ul class="navbar-nav ms-auto">
      {% if app.user %}
        <li class="nav-item">
          <a class="nav-link" href="{{ path('cart_index') }}">
            <i class="fas fa-shopping-cart" style="color: white;"></i> Cart
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_commande_historique') }}">
            <i class="fas fa-receipt" style="color: white;"></i> My Orders
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link disabled" href="#">
            <i class="fas fa-user" style="color: white;"></i> 
            {{ app.user.userIdentifier }}
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
        </li>
      {% else %}
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_login') }}">Login</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ path('app_register') }}">Register</a>
        </li>
      {% endif %}
    </ul>

    </div>
  </div>
</nav>
{% for type,message in app.flashes %}
    <div class="alert alert-{{ type }}">
        {{ message[0] }}
    </div>
{% endfor %}
{% block body %}{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
