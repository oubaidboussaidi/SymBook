{% extends 'base.html.twig' %}

{% block title %}Commande Validée{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-success">Commande validée !</h1>
    <p>Merci pour votre commande numéro <strong>#{{ commande.id }}</strong></p>
    <p>Montant total : <strong>{{ commande.total }} DT</strong></p>
    <a href="/" class="btn btn-primary mt-3">Retour à l'accueil</a>
</div>
{% endblock %}
