{% extends 'base.html.twig' %}

{% block title %}Commandes - Admin{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Gestion des commandes</h1>

    <form method="get" class="mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <label for="statut" class="col-form-label">Filtrer par statut :</label>
            </div>
            <div class="col-auto">
                <select name="statut" id="statut" class="form-select">
                    <option value="">-- Tous --</option>
                    <option value="en_attente" {{ selectedStatus == 'en_attente' ? 'selected' }}>En attente</option>
                    <option value="en_cours" {{ selectedStatus == 'en_cours' ? 'selected' }}>En cours</option>
                    <option value="livree" {{ selectedStatus == 'livree' ? 'selected' }}>Livrée</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filtrer</button>
            </div>
        </div>
    </form>

    {% if commandes is empty %}
        <div class="alert alert-info">Aucune commande trouvée.</div>
    {% else %}
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Client</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td>{{ commande.id }}</td>
                        <td>{{ commande.user.email }}</td>
                        <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                        <td>{{ commande.total|number_format(2, '.', ',') }} DT</td>
                        <td><span class="badge bg-secondary">{{ commande.statut }}</span></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}
